.env

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Data & DB (large / derived — parse once, cached in DuckDB)
data/raw/
data/db/
data/clips/
data/logs/
data/cache/
data/commentary/
data/shuttle_pred/

# Vendored research repos (cloned by hand; see HANDOFF §Phase 2)
third_party/
*.duckdb
*.mp4
*.mkv
*.webm
*.part
# …but the web app's annotated rally clips ship with the site (Vercel builds from git)
!web/public/clips/**/*.mp4
# …as does the landing page's hero rally (a trimmed, re-compressed clip)
!web/public/hero/*.mp4
!web/public/hero.mp4

# Model weights (auto-downloaded by ultralytics)
*.pt

# OS
.DS_Store

# Plan-B share bundles are build output; the blobs are gitignored above
dist/
node_modules/
.wrangler/
.dev.vars
