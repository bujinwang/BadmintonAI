{
  "name": "bm-share",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "bundle:dry": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "verify:isolation": "node scripts/check-isolation.mjs",
    "check": "npm run verify:isolation && npm run typecheck && npm run bundle:dry",
    "db:local": "wrangler d1 execute bm-share --local --file=schema.sql",
    "db:remote": "wrangler d1 execute bm-share --remote --file=schema.sql"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
